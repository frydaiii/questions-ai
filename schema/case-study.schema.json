{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://questions-ai.local/schema/case-study.schema.json",
  "title": "CaseStudy",
  "description": "A cross-domain business scenario shared by 3-5 linked questions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "scenario", "question_ids"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CS-[0-9]{2}$",
      "description": "CS-{seq:02d}, e.g. CS-01"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "scenario": {
      "type": "string",
      "minLength": 200,
      "description": "The multi-paragraph business scenario shared by all linked questions."
    },
    "question_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^Q-D[1-5]-[0-9]{4}$"
      }
    }
  }
}
