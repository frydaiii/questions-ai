{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://questions-ai.local/schema/theory.schema.json",
  "title": "TheoryCard",
  "description": "A reusable explanation of one AIF-C01 concept, referenced by many questions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "task_statements",
    "title",
    "summary",
    "key_points",
    "rule_of_thumb",
    "common_confusions",
    "aws_services",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TH-D[1-5]-[0-9]{3}$",
      "description": "TH-D{domain}-{seq:03d}, e.g. TH-D3-006"
    },
    "domain": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "task_statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[1-5]\\.[1-4]$"
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "key_points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "rule_of_thumb": {
      "type": "string",
      "minLength": 10
    },
    "common_confusions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "aws_services": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://(aws\\.amazon\\.com|docs\\.aws\\.amazon\\.com)/"
      }
    }
  }
}
