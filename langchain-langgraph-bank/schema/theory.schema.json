{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://questions-ai.local/schema/langchain-langgraph/theory.schema.json",
  "title": "TheoryCard",
  "description": "A reusable explanation of one AI agent theory concept, referenced by many questions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "task_statements",
    "title",
    "summary",
    "key_points",
    "rule_of_thumb",
    "common_confusions",
    "related_tech",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TH-D[1-6]-[0-9]{3}$",
      "description": "TH-D{domain}-{seq:03d}, e.g. TH-D4-006"
    },
    "domain": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "task_statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[1-6]\\.[1-4]$"
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "key_points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "rule_of_thumb": {
      "type": "string",
      "minLength": 10
    },
    "common_confusions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "related_tech": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "description": "Named concepts, techniques, systems, or papers relevant to this card, e.g. 'ReAct', 'AutoGPT', 'Reflexion', 'belief-desire-intention'. Framework/vendor-specific product names should be avoided; this bank is framework-agnostic."
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://(arxiv\\.org|www\\.anthropic\\.com|openai\\.com|deepmind\\.google|research\\.google|www\\.microsoft\\.com|aclanthology\\.org|proceedings\\.neurips\\.cc|proceedings\\.mlr\\.press)/"
      }
    }
  }
}
